 aggregate over the join                                 | ok                                                                                                     | t      |     7 |       0 |     0
 ORDER BY ... LIMIT in the join's own order              | ok                                                                                                     | t      |    25 |       0 |     0
 ORDER BY ... LIMIT against the join's order             | ok                                                                                                     | t      |    25 |       0 |     0
 in a CTE, used twice                                    | ok                                                                                                     | t      |  1993 |       0 |     0
 in an EXISTS sublink                                    | ok                                                                                                     | t      |     7 |       0 |     0
(32 rows)

--
-- Inputs that arrive sorted from an index, so the plan has no Sort
--
CREATE INDEX ON asof_t_g (sym, ts);
CREATE INDEX ON asof_q_g (sym, ts);
CREATE INDEX ON asof_t_g (sym, ts DESC NULLS LAST);
CREATE INDEX ON asof_q_g (sym, ts DESC NULLS LAST);
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SELECT jt, op, d.*
FROM (VALUES ('LEFT'), ('INNER')) AS j(jt),
     (VALUES ('>='), ('>'), ('<='), ('<')) AS o(op),
     LATERAL asof_diff(format(
       'SELECT t.sym, t.ts, q.ts AS qts FROM asof_t_g t ASOF %s JOIN asof_q_g q '
       'ON t.sym = q.sym AND t.ts %s q.ts', jt, op)) d
ORDER BY 1 DESC, 2;
  jt   | op | status | native | nrows | missing | extra 
-------+----+--------+--------+-------+---------+-------
 LEFT  | <  | ok     | t      |  2000 |       0 |     0
 LEFT  | <= | ok     | t      |  2000 |       0 |     0
 LEFT  | >  | ok     | t      |  2000 |       0 |     0
 LEFT  | >= | ok     | t      |  2000 |       0 |     0
 INNER | <  | ok     | t      |  2000 |       0 |     0
 INNER | <= | ok     | t      |  2000 |       0 |     0
 INNER | >  | ok     | t      |  1988 |       0 |     0
 INNER | >= | ok     | t      |  1988 |       0 |     0
(8 rows)

RESET enable_seqscan;
RESET enable_bitmapscan;
--
-- Sorts that spill to disk
--
CREATE TABLE asof_t_big AS
  SELECT (g % 11)::text AS sym, (g * 7) % 100003 AS ts
  FROM generate_series(1, 30000) g;
CREATE TABLE asof_q_big AS
  SELECT (g % 13)::text AS sym, (g * 5) % 100019 AS ts
  FROM generate_series(1, 30000) g;
-- The oracle probes this index once per left row; without it the test
-- takes minutes.  The native plan still sorts the left input, and both
-- inputs for <, which wants the match column descending.
CREATE INDEX ON asof_q_big (sym, ts);
ANALYZE asof_t_big, asof_q_big;
SET work_mem = '64kB';
SELECT jt, op, d.*
FROM (VALUES ('LEFT'), ('INNER')) AS j(jt),
     (VALUES ('>='), ('<')) AS o(op),
     LATERAL asof_diff(format(
       'SELECT t.sym, t.ts, q.ts AS qts FROM asof_t_big t ASOF %s JOIN asof_q_big q '
       'ON t.sym = q.sym AND t.ts %s q.ts', jt, op)) d
ORDER BY 1 DESC, 2;
  jt   | op | status | native | nrows | missing | extra 
-------+----+--------+--------+-------+---------+-------
 LEFT  | <  | ok     | t      | 30000 |       0 |     0
 LEFT  | >= | ok     | t      | 30000 |       0 |     0
 INNER | <  | ok     | t      | 29995 |       0 |     0
 INNER | >= | ok     | t      | 29995 |       0 |     0
(4 rows)

RESET work_mem;
--
-- Prepared statements, with generic and custom plans.  The switch is read
-- when the statement is analyzed, so each side is prepared under its own
-- setting.
--
SET enable_asofjoin_native = off;
PREPARE asof_p_ref(int) AS
  SELECT t.sym, t.ts, q.ts AS qts FROM asof_t_g t ASOF LEFT JOIN asof_q_g q
    ON t.sym = q.sym AND t.ts - $1 >= q.ts;
SET enable_asofjoin_native = on;
PREPARE asof_p_nat(int) AS
  SELECT t.sym, t.ts, q.ts AS qts FROM asof_t_g t ASOF LEFT JOIN asof_q_g q
    ON t.sym = q.sym AND t.ts - $1 >= q.ts;
CREATE FUNCTION asof_diff_prepared(arg int, OUT missing bigint, OUT extra bigint)
LANGUAGE plpgsql AS
$$
BEGIN
    EXECUTE format('CREATE TEMP TABLE asof_ref AS EXECUTE asof_p_ref(%s)', arg);
    EXECUTE format('CREATE TEMP TABLE asof_nat AS EXECUTE asof_p_nat(%s)', arg);
    SELECT count(*) INTO missing FROM (TABLE asof_ref EXCEPT ALL TABLE asof_nat) a;
    SELECT count(*) INTO extra FROM (TABLE asof_nat EXCEPT ALL TABLE asof_ref) b;
    DROP TABLE asof_ref, asof_nat;
END;
$$;
SET plan_cache_mode = force_custom_plan;
SELECT 'custom' AS plan, arg, d.* FROM generate_series(0, 4, 2) arg,
  LATERAL asof_diff_prepared(arg) d;
  plan  | arg | missing | extra 
--------+-----+---------+-------
 custom |   0 |       0 |     0
 custom |   2 |       0 |     0
 custom |   4 |       0 |     0
(3 rows)

SET plan_cache_mode = force_generic_plan;
SELECT 'generic' AS plan, arg, d.* FROM generate_series(0, 4, 2) arg,
  LATERAL asof_diff_prepared(arg) d;
  plan   | arg | missing | extra 
---------+-----+---------+-------
 generic |   0 |       0 |     0
 generic |   2 |       0 |     0
 generic |   4 |       0 |     0
(3 rows)

RESET plan_cache_mode;
DEALLOCATE asof_p_ref;
DEALLOCATE asof_p_nat;
DROP FUNCTION asof_diff_prepared(int);
DROP VIEW asof_q_even;
DROP TABLE asof_t_n, asof_q_n, asof_t_g, asof_q_g, asof_t_ty, asof_q_ty,
  asof_syms, asof_t_big, asof_q_big;
DROP FUNCTION asof_diff(text);
